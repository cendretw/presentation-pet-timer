{
  "manifest_version": 3,
  "name": "簡報小助手 - 寵物計時提醒",
  "version": "2.3",
  "description": "根據簡報開始時間，定時在角落提醒你餵魚、逗貓、看土撥鼠或樹懶。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "設定簡報寵物",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cat.png", "cat.gif",
        "fish.png", "fish.gif",
        "groundhog.png", "groundhog.gif",
        "sloth.png", "sloth.gif"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}